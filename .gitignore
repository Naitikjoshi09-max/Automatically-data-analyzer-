# ---------------------------------------------------------
# Preset Datasets Generator
# ---------------------------------------------------------
@st.cache_data
def get_preset_data(preset_type):
    np.random.seed(42)
    dates = pd.date_range(start="2026-01-01", periods=90, freq="D")
    
    if preset_type == "🛒 E-Commerce Sales":
        items = ["Wireless Headphones", "Smartwatch", "Mechanical Keyboard", "USB-C Hub", "Ergonomic Chair"]
        regions = ["North America", "Europe", "Asia-Pacific", "Latin America"]
        return pd.DataFrame({
            "Date": np.random.choice(dates, 300),
            "Product": np.random.choice(items, 300),
            "Region": np.random.choice(regions, 300),
            "Units_Sold": np.random.randint(1, 20, 300),
            "Price": np.random.uniform(25.0, 250.0, 300).round(2),
            "Revenue": np.random.uniform(50.0, 1500.0, 300).round(2)
        })
    elif preset_type == "📢 Marketing Campaigns":
        channels = ["Google Ads", "Meta Ads", "TikTok Ads", "Email Marketing", "LinkedIn"]
        return pd.DataFrame({
            "Date": np.random.choice(dates, 250),
            "Channel": np.random.choice(channels, 250),
            "Impressions": np.random.randint(5000, 100000, 250),
            "Clicks": np.random.randint(100, 4000, 250),
            "Ad_Spend": np.random.uniform(100.0, 2500.0, 250).round(2),
            "Conversions": np.random.randint(5, 150, 250)
        })
    else:  # Personal Finance
        categories = ["Housing", "Groceries", "Dining Out", "Subscriptions", "Utilities", "Travel"]
        return pd.DataFrame({
            "Date": np.random.choice(dates, 200),
            "Category": np.random.choice(categories, 200),
            "Payment_Method": np.random.choice(["Credit Card", "Debit Card", "Bank Transfer"], 200),
            "Amount": np.random.uniform(10.0, 450.0, 200).round(2)
        })

def fig_to_bytes(fig):
    buf = io.BytesIO()
    fig.savefig(buf, format="png", dpi=300, bbox_inches="tight")
    buf.seek(0)
    return buf

# ---------------------------------------------------------
# Sidebar Configuration & Controls
# ---------------------------------------------------------
st.sidebar.title("🎨 Visual Studio")

# Color Palette Picker
palette_choice = st.sidebar.selectbox(
    "🌈 Select Color Theme",
    ["Vibrant Neon", "Sunset Coral", "Emerald Mint", "Cyberpunk Dark", "Ocean Blue"],
    help="Changes chart color accents across the entire dashboard."
)

palette_map = {
    "Vibrant Neon": ["#6366f1", "#ec4899", "#06b6d4", "#f59e0b", "#10b981"],
    "Sunset Coral": ["#ff6b6b", "#fca311", "#ff85a1", "#e63946", "#f1faee"],
    "Emerald Mint": ["#059669", "#10b981", "#34d399", "#0284c7", "#06b6d4"],
    "Cyberpunk Dark": ["#ff007f", "#7b2cbf", "#00f5d4", "#f15bb5", "#fee440"],
    "Ocean Blue": ["#1e3a8a", "#2563eb", "#3b82f6", "#60a5fa", "#93c5fd"]
}
selected_palette = palette_map[palette_choice]

st.sidebar.markdown("---")
st.sidebar.subheader("📂 Data Source")

data_mode = st.sidebar.radio("Choose Mode:", ["Upload Custom CSV", "Use Demo Templates"])

if data_mode == "Upload Custom CSV":
    uploaded_file = st.sidebar.file_uploader("Drop your CSV file here", type=["csv"])
    if uploaded_file is not None:
        try:
            df = pd.read_csv(uploaded_file)
            st.sidebar.success("File uploaded successfully!")
        except Exception as e:
            st.sidebar.error(f"Error loading CSV: {e}")
            df = get_preset_data("🛒 E-Commerce Sales")
    else:
        st.sidebar.info("Upload a file above or switch to Demo Templates.")
        df = get_preset_data("🛒 E-Commerce Sales")
else:
    preset_choice = st.sidebar.selectbox(
        "Select Demo Dataset",
        ["🛒 E-Commerce Sales", "📢 Marketing Campaigns", "💳 Personal Spending"]
    )
    df = get_preset_data(preset_choice)

# Detect Column Types
numeric_cols = df.select_dtypes(include=[np.number]).columns.tolist()
categorical_cols = df.select_dtypes(include=['object', 'category']).columns.tolist()
date_cols = [c for c in df.columns if 'date' in c.lower() or 'time' in c.lower()]

# Convert detected date columns
for dc in date_cols:
    df[dc] = pd.to_datetime(df[dc], errors='coerce')

# ---------------------------------------------------------
# Main UI Header
# ---------------------------------------------------------
st.markdown('<div class="main-title">✨ Universal Business Analytics Studio</div>', unsafe_allow_html=True)
st.markdown("Automated insights, vibrant visualizations, and exportable reports in one click.")

# Dynamic Executive Insight Summary
if numeric_cols and categorical_cols:
    top_cat_col = categorical_cols[0]
    top_num_col = numeric_cols[0]
    top_performer = df.groupby(top_cat_col)[top_num_col].sum().idxmax()
    max_val = df.groupby(top_cat_col)[top_num_col].sum().max()
    
    st.markdown(f"""
    <div class="insight-box">
        🚀 <b>Executive Takeaway:</b> Highest total <b>{top_num_col}</b> belongs to 
        <b>{top_performer}</b> with a total value of <b>{max_val:,.2f}</b> across current records.
    </div>
    """, unsafe_allow_html=True)

# ---------------------------------------------------------
# Colorful KPI Metric Cards
# ---------------------------------------------------------
st.subheader("📌 Key Performance Indicators")
k1, k2, k3, k4 = st.columns(4)

with k1:
    st.markdown(f"""
    <div class="metric-card metric-card-1">
        <div class="metric-title">Total Records</div>
        <div class="metric-value">{len(df):,}</div>
    </div>
    """, unsafe_allow_html=True)

with k2:
    val = f"{df[numeric_cols[0]].sum():,.2f}" if numeric_cols else "N/A"
    lbl = numeric_cols[0] if numeric_cols else "Metric 1"
    st.markdown(f"""
    <div class="metric-card metric-card-2">
        <div class="metric-title">Total {lbl}</div>
        <div class="metric-value">{val}</div>
    </div>
    """, unsafe_allow_html=True)

with k3:
    val = f"{df[numeric_cols[0]].mean():,.2f}" if numeric_cols else "N/A"
    st.markdown(f"""
    <div class="metric-card metric-card-3">
        <div class="metric-title">Average {lbl}</div>
        <div class="metric-value">{val}</div>
    </div>
    """, unsafe_allow_html=True)

with k4:
    cat_count = len(categorical_cols)
    num_count = len(numeric_cols)
    st.markdown(f"""
    <div class="metric-card metric-card-4">
        <div class="metric-title">Data Attributes</div>
        <div class="metric-value">{num_count} Num / {cat_count} Cat</div>
    </div>
    """, unsafe_allow_html=True)

st.markdown("<br>", unsafe_allow_html=True)

# ---------------------------------------------------------
# Interactive Visualization Section
# ---------------------------------------------------------
st.subheader("📊 Interactive Visual Studio")

if numeric_cols:
    col_chart1, col_chart2 = st.columns(2)

    # Chart 1: Categorical Bar Chart
    with col_chart1:
        st.markdown("##### 🏷️ Category Breakdown")
        cat_select = st.selectbox("Category Field", options=categorical_cols if categorical_cols else df.columns, key="c1")
        num_select = st.selectbox("Metric Field", options=numeric_cols, key="n1")

        grouped = df.groupby(cat_select)[num_select].sum().reset_index().sort_values(by=num_select, ascending=False).head(10)

        fig, ax = plt.subplots(figsize=(7, 4.2))
        sns.barplot(data=grouped, x=num_select, y=cat_select, palette=sns.color_palette(selected_palette), ax=ax)
        ax.set_title(f"Top 10 {cat_select} by {num_select}", fontsize=11, fontweight="bold")
        ax.set_xlabel(num_select)
        ax.set_ylabel(cat_select)
        
        for p in ax.patches:
            width = p.get_width()
            ax.annotate(f"{width:,.0f}", (width, p.get_y() + p.get_height() / 2.),
                        ha='left', va='center', xytext=(5, 0), textcoords='offset points', fontsize=8)
            
        st.pyplot(fig)
        st.download_button("📥 Download Bar Chart", data=fig_to_bytes(fig), file_name="bar_chart.png", mime="image/png")

    # Chart 2: Distribution / Correlation
    with col_chart2:
        st.markdown("##### 📈 Distribution & Spread")
        dist_select = st.selectbox("Select Numeric Column", options=numeric_cols, key="d1")

        fig, ax = plt.subplots(figsize=(7, 4.2))
        sns.histplot(df[dist_select].dropna(), kde=True, color=selected_palette[0], ax=ax)
        ax.set_title(f"Distribution Density of {dist_select}", fontsize=11, fontweight="bold")
        ax.set_xlabel(dist_select)
        
        st.pyplot(fig)
        st.download_button("📥 Download Distribution Chart", data=fig_to_bytes(fig), file_name="distribution.png", mime="image/png")

    st.markdown("---")

    # Time Series Section (if date column exists)
    if date_cols:
        st.subheader("📅 Time-Series Trends")
        active_date_col = date_cols[0]
        ts_metric = st.selectbox("Select Trend Metric", options=numeric_cols, key="ts_m")

        ts_df = df.groupby(df[active_date_col].dt.date)[ts_metric].sum().reset_index()
        ts_df["Rolling_Avg"] = ts_df[ts_metric].rolling(window=7, min_periods=1).mean()

        fig, ax = plt.subplots(figsize=(12, 3.8))
        ax.plot(ts_df[active_date_col], ts_df[ts_metric], color=selected_palette[1], alpha=0.35, label="Daily Total", marker="o", markersize=3)
        ax.plot(ts_df[active_date_col], ts_df["Rolling_Avg"], color=selected_palette[0], linewidth=2.5, label="7-Day Moving Average")
        ax.set_title(f"Timeline Trend of {ts_metric}", fontsize=12, fontweight="bold")
        ax.legend()
        plt.xticks(rotation=30)
        st.pyplot(fig)

st.markdown("---")

# ---------------------------------------------------------
# Raw Data Explorer & Export
# ---------------------------------------------------------
st.subheader("📋 Dataset Explorer")
st.dataframe(df, use_container_width=True)

csv_data = df.to_csv(index=False).encode('utf-8')
st.download_button(
    label="💾 Export Processed CSV Data",
    data=csv_data,
    file_name="analytics_export.csv",
    mime="text/csv"
)
