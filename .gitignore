import streamlit as st
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import io
import streamlit as st

# Password License Lock
if "authenticated" not in st.session_state:
    st.session_state["authenticated"] = False

if not st.session_state["authenticated"]:
    st.set_page_config(page_title="License Verification", page_icon="🔒")
    st.title("🔒 License Verification Required")
    st.write("Please enter your customer license key to access the dashboard.")
    
    user_key = st.text_input("Enter License Key:", type="password")
    if st.button("Unlock Studio"):
        if user_key == "VIP-PASS-2026":  # Set your password here
            st.session_state["authenticated"] = True
            st.rerun()
        else:
            st.error("Invalid key. Please check your purchase receipt.")
    st.stop()
# ---------------------------------------------------------
# Page Configuration
# ---------------------------------------------------------
st.set_page_config(
    page_title="Vibrant Analytics Studio",
    page_icon="🎨",
    layout="wide",
    initial_sidebar_state="expanded"
)

# ---------------------------------------------------------
# Custom Modern Visual Styling (CSS)
# ---------------------------------------------------------
st.markdown("""
<style>
    /* Main Background & Fonts */
    .stApp {
        background-color: #f8fafc;
    }
    
    /* Title Styling */
    .main-title {
        font-size: 2.2rem;
